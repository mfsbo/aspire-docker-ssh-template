{
  "name": "vue-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "generate:app-info": "tsx scripts/appMetadataGenerator.ts",
    "prebuild": "npm run generate:app-info",
